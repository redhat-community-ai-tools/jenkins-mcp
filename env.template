# Jenkins Nightly Analyzer - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Jenkins Configuration
# =============================================================================
JENKINS_URL=https://your-jenkins-url.example.com
JENKINS_USER=your-username
JENKINS_TOKEN=your-api-token-or-password

# Optional: Jenkins MCP Server
# Leave empty to use direct HTTP API (recommended for internal Jenkins)
# JENKINS_MCP_URL=

# For ambient tool integration, run MCP server locally:
# git clone https://github.com/bdattoma/rhoai-jenkins-mcp.git
# cd rhoai-jenkins-mcp && uv run main.py
# JENKINS_MCP_URL=http://localhost:8000/sse

# Note: Public MCP servers can't reach internal Jenkins instances

# =============================================================================
# Jira Configuration
# =============================================================================
JIRA_URL=https://issues.redhat.com
JIRA_TOKEN=your-jira-api-token

# =============================================================================
# GitLab Configuration (for commit analysis)
# =============================================================================
GITLAB_URL=https://gitlab.cee.redhat.com
GITLAB_TOKEN=your-gitlab-personal-access-token

# =============================================================================
# Repository Paths (REQUIRED)
# =============================================================================
# Path to your odh-dashboard repository clone (GitHub)
FRONTEND_REPO_PATH=/path/to/your/odh-dashboard

# Path to your Jenkins configuration repository clone (GitLab)
JENKINS_REPO_PATH=/path/to/your/jenkins

# =============================================================================
# Cluster Configuration
# =============================================================================
# RHOAI Cluster
RHOAI_API_SERVER=https://api.your-rhoai-cluster.example.com:6443
RHOAI_USERNAME=your-cluster-username
RHOAI_PASSWORD=your-cluster-password

# ODH Cluster
ODH_API_SERVER=https://api.your-odh-cluster.example.com:6443
ODH_USERNAME=your-cluster-username
ODH_PASSWORD=your-cluster-password

# =============================================================================
# Report Configuration
# =============================================================================
REPORT_OUTPUT_DIR=./reports

# =============================================================================
# Optional: Test variables paths
# =============================================================================
RHOAI_TEST_VARIABLES=/path/to/rhoai/test-variables.yml
ODH_TEST_VARIABLES=/path/to/odh/test-variables.yml

# =============================================================================
# Optional: Tracer tool path (for image analysis)
# =============================================================================
TRACER_PATH=/path/to/tracer/tracer.sh

# =============================================================================
# Optional: Scheduler Configuration
# =============================================================================
SCHEDULE_TIME=09:30

# =============================================================================
# Optional: SSL Verification (Security)
# =============================================================================
# Set to "false" only for internal CAs or self-signed certificates
# Default: true (secure - verifies SSL certificates)
# SSL_VERIFY=true
